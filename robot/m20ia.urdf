<?xml version="1.0"?>
<!-- FANUC M-20iA, expanded from ROS-Industrial fanuc_m20ia_support/urdf/m20ia_macro.xacro (prefix "")
     at github.com/ros-industrial/fanuc d8f42bd7 (2025-02-19). BSD licence: see LICENSE.
     Only change: mesh paths made relative (meshes/...) and materials inlined from fanuc_resources. -->
<robot name="fanuc_m20ia">
  <material name="fanuc_yellow"><color rgba="0.96 0.76 0.13 1.0"/></material>
  <material name="fanuc_gray28"><color rgba="0.2784 0.2784 0.2784 1.0"/></material>
  <material name="fanuc_black"><color rgba="0.15 0.15 0.15 1.0"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/visual/base_link.stl"/></geometry><material name="fanuc_gray28"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/collision/base_link.stl"/></geometry></collision>
  </link>
  <link name="link_1">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/visual/link_1.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/collision/link_1.stl"/></geometry></collision>
  </link>
  <link name="link_2">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/visual/link_2.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/collision/link_2.stl"/></geometry></collision>
  </link>
  <link name="link_3">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/visual/link_3.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/collision/link_3.stl"/></geometry></collision>
  </link>
  <link name="link_4">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/visual/link_4.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/collision/link_4.stl"/></geometry></collision>
  </link>
  <link name="link_5">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/visual/link_5.stl"/></geometry><material name="fanuc_yellow"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/collision/link_5.stl"/></geometry></collision>
  </link>
  <link name="link_6">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/visual/link_6.stl"/></geometry><material name="fanuc_black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/collision/link_6.stl"/></geometry></collision>
  </link>

  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.525" rpy="0 0 0"/><parent link="base_link"/><child link="link_1"/><axis xyz="0 0 1"/>
    <limit lower="-2.967060" upper="2.967060" effort="0" velocity="3.403392"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <origin xyz="0.150 0 0" rpy="0 0 0"/><parent link="link_1"/><child link="link_2"/><axis xyz="0 1 0"/>
    <limit lower="-1.745329" upper="2.792527" effort="0" velocity="3.054326"/>
  </joint>
  <joint name="joint_3" type="revolute">
    <origin xyz="0 0 0.790" rpy="0 0 0"/><parent link="link_2"/><child link="link_3"/><axis xyz="0 -1 0"/>
    <limit lower="-3.228859" upper="4.766843" effort="0" velocity="3.141593"/>
  </joint>
  <joint name="joint_4" type="revolute">
    <origin xyz="0 0 0.250" rpy="0 0 0"/><parent link="link_3"/><child link="link_4"/><axis xyz="-1 0 0"/>
    <limit lower="-3.490658" upper="3.490658" effort="0" velocity="6.283185"/>
  </joint>
  <joint name="joint_5" type="revolute">
    <origin xyz="0.835 0 0" rpy="0 0 0"/><parent link="link_4"/><child link="link_5"/><axis xyz="0 -1 0"/>
    <limit lower="-2.443461" upper="2.443461" effort="0" velocity="6.283185"/>
  </joint>
  <joint name="joint_6" type="revolute">
    <origin xyz="0.100 0 0" rpy="0 0 0"/><parent link="link_5"/><child link="link_6"/><axis xyz="-1 0 0"/>
    <limit lower="-4.712389" upper="4.712389" effort="0" velocity="9.599311"/>
  </joint>

  <link name="base"/>
  <joint name="base_link-base" type="fixed">
    <origin xyz="0 0 0.525" rpy="0 0 0"/><parent link="base_link"/><child link="base"/>
  </joint>
  <link name="flange"/>
  <joint name="joint_6-flange" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/><parent link="link_6"/><child link="flange"/>
  </joint>
  <link name="tool0"/>
  <joint name="link_6-tool0" type="fixed">
    <origin xyz="0 0 0" rpy="3.141592653589793 -1.5707963267948966 0"/><parent link="flange"/><child link="tool0"/>
  </joint>
</robot>
